# ============================================================
# Ascend — пример конфигурации окружения
# Скопируйте этот файл в .env и при необходимости измените значения.
# Секреты хранятся ТОЛЬКО в окружении и никогда в базе данных (раздел 56 ТЗ).
# ============================================================

# --- Общее ---
APP_ENV=development
DEBUG=false

# --- База данных ---
DATABASE_URL=sqlite:///./ascend.db

# --- Безопасность ---
SECRET_KEY=change-me-to-a-random-string
# Telegram token передаётся только через окружение (Sprint 8):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# --- Игровой баланс (раздел 57 ТЗ) ---
# EXP, необходимый для перехода с уровня 1 на уровень 2.
EXP_BASE=100
# Множитель роста требований к следующему уровню: EXP_next = EXP_base * LEVEL_MULTIPLIER^(level-1)
LEVEL_MULTIPLIER=1.2
# Глобальный множитель получаемого опыта.
EXP_MULTIPLIER=1.0

# --- Readiness Engine (разделы 17-18 ТЗ) ---
# Веса факторов (сумма = 1.0). JSON-значение, переопределяет значение по умолчанию.
READINESS_WEIGHTS={"sleep":0.25,"resting_hr":0.20,"training_load":0.20,"recovery":0.20,"activity":0.15}
# Ниже этого значения готовности нагрузка снижается (раздел 23 ТЗ).
LOW_READINESS_THRESHOLD=40
# Порог тренировочной нагрузки, после которого включается recovery period (раздел 72 ТЗ).
RECOVERY_THRESHOLD=0.85

# --- Quest Engine (раздел 22 ТЗ) ---
# Модификаторы сложности квестов. JSON-значение.
QUEST_DIFFICULTY_MODIFIERS={"base":0.6,"low_readiness":0.5,"high_readiness":1.1,"max":1.0}